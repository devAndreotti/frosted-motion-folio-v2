{
  "$schema": "https://unpkg.com/wrangler@4.148.0/config-schema.json",
  "name": "devandreotti-portfolio",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-15",
  // production answers only on the custom domain; PR versions still get a preview URL on devandreotti.workers.dev
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    // npm run build:vps -- the build with base=/ (GitHub Pages uses the /frosted-motion-folio-v2/ one)
    "directory": "./dist-vps",
    "binding": "ASSETS",
    // one-page app: unknown paths get index.html and the React 404 page
    "not_found_handling": "single-page-application",
    // pages and /e/ beacons go through the Worker (www/http redirects); static files skip it and stay free
    "run_worker_first": ["/*", "!/assets/*", "!/projects/*", "!/now/*", "!/favicon.ico", "!/og-image.png", "!/profile.*", "!/profile/*", "!/placeholder.svg", "!/robots.txt", "!/sitemap.xml", "!/blog/rss.xml", "!/blog/index.json"]
  },
  // "1" turns every page into public/offline.html with a 503 (worker/index.js). Flip it in the dashboard
  // (Workers > devandreotti-portfolio > Settings > Variables) without a deploy; the next deploy resets it to "0".
  "vars": { "MAINTENANCE": "0" },
  // the zone devandreotti.com is on Cloudflare (nameservers moved from Hostinger); www answers too and redirects to the apex
  "routes": [
    { "pattern": "devandreotti.com", "custom_domain": true },
    { "pattern": "www.devandreotti.com", "custom_domain": true }
  ],
  // Likes on blog posts (worker/likes.js) live in this D1 database (table from worker/migrations/0001_likes.sql).
  // Optional hardening: npx wrangler secret put LIKES_SALT   -> any long random string (the code has a default).
  "d1_databases": [
    { "binding": "DB", "database_name": "devandreotti-likes", "database_id": "a9aa09d8-fec5-4c60-8e28-da5a44c33a6e", "migrations_dir": "worker/migrations" }
  ],
  "observability": { "enabled": true }
}
